# ===========================================================================
# agentpulse — LLM configuration (copy to .env and fill in your own keys)
# ===========================================================================
# The model is a LiteLLM model string. A few common examples:
#
#   OpenAI           LLM_MODEL=openai/gpt-4o-mini        + OPENAI_API_KEY
#   Anthropic        LLM_MODEL=anthropic/claude-3-5-sonnet-latest + ANTHROPIC_API_KEY
#   DeepSeek         LLM_MODEL=deepseek/deepseek-chat     + DEEPSEEK_API_KEY
#   Any OpenAI-compatible endpoint (Azure, vLLM, Ollama, gateways...):
#                    LLM_MODEL=openai/<model-name>
#                    LLM_API_BASE=https://your-gateway.example/v1
#                    LLM_API_KEY=sk-...

LLM_MODEL=openai/gpt-4o-mini
# LLM_API_BASE=
# LLM_API_KEY=

# --- sampling ----------------------------------------------------------------
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# --- harness ------------------------------------------------------------------
# Max agent-loop iterations (anti-runaway loop guard).
LLM_MAX_STEPS=10
# Default system prompt (override if you want a persona).
# LLM_SYSTEM_PROMPT=You are a helpful AI assistant running inside an agent harness...
# 1 to trace loop steps to stderr.
HARNESS_VERBOSE=0
